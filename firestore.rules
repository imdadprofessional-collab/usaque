rules_version = '2';

// Matches what UserRepositoryImpl.syncToCloud() writes: users/{uid} holds only the small
// per-user document (profile, premium status, streak, settings) — never the question bank.
// Paste this into Firebase Console -> Firestore Database -> Rules, or deploy with the
// Firebase CLI (`firebase deploy --only firestore:rules`) once you're logged in locally.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
